# "mock" generates synthetic results in the browser. "live" calls the backend at /api/screen.
VITE_API_MODE=mock

# Base URL of the FastAPI backend. Leave empty to call the same origin (/api/screen).
VITE_API_BASE_URL=

# Dev server proxy target for /api (read by vite.config.ts only).
VITE_API_PROXY_TARGET=http://localhost:8000

# Canonical site URL for og:image and og:url. On Vercel it is filled in automatically.
VITE_SITE_URL=

# Footer links. Without them the footer shows placeholder addresses.
VITE_GITHUB_URL=
VITE_DOCS_URL=
VITE_CONTACT_EMAIL=
